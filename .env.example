# PostgreSQL Configuration
POSTGRES_DB=nagarbondhu_db
POSTGRES_USER=nagarbondhu_user
POSTGRES_PASSWORD=nagarbondhu_pass
DB_URL=jdbc:postgresql://localhost:5432/nagarbondhu_db
DB_USERNAME=nagarbondhu_user
DB_PASSWORD=nagarbondhu_pass

# Test Database Configuration
TEST_DB_URL=jdbc:postgresql://localhost:5432/nagarbondhu_test
TEST_DB_USERNAME=nagarbondhu_user
TEST_DB_PASSWORD=nagarbondhu_pass

# JWT Configuration (minimum 32 characters for HS256)
JWT_SECRET=NagarBondhuSuperSecretJwtSigningKey2026ChangeInProd!
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# File Uploads
APP_UPLOAD_DIR=./uploads

# Grafana Admin Credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
